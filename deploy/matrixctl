#!/usr/bin/env python3
"""Validate, deploy, and control the Poor Louis Farms display over SSH."""
import argparse
import base64
import hashlib
import json
import shlex
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from matrix_animation import validate_gif


def encode(data):
    return base64.b64encode(data).decode("ascii")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", default="epi13@mncs-pi.local", help="SSH host or user@host")
    commands = parser.add_subparsers(dest="operation", required=True)
    for name in ("setup", "status", "start", "stop", "restart", "restore", "halloween"):
        commands.add_parser(name)
    commands.add_parser("brightness").add_argument("level", type=int, choices=range(1, 101),
                                                    metavar="1–100")
    commands.add_parser("deploy").add_argument("gif", type=Path)
    args = parser.parse_args()
    request = {"operation": args.operation}

    if args.operation == "deploy":
        print(validate_gif(args.gif), flush=True)
        data = args.gif.read_bytes()
        request.update(gif=encode(data), sha256=hashlib.sha256(data).hexdigest())
        print(f"Local GIF SHA-256 {request['sha256']}", flush=True)
    if args.operation in ("setup", "deploy"):
        request["player"] = {
            filename: encode((ROOT / filename).read_bytes())
            for filename in ("matrix_animation.py", "poor_louis_farms.py")
        }
    if args.operation == "brightness":
        request["level"] = args.level
    helper = (ROOT / "deploy" / "matrix_host.py").read_text()
    remote = shlex.join(["sudo", "-n", "/usr/bin/python3", "-c", helper])
    result = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o",
         "StrictHostKeyChecking=yes", "--", args.host, remote],
        input=json.dumps(request),
        text=True,
    )
    return result.returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        sys.exit(str(error))
